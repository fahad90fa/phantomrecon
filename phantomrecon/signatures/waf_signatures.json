      "body_patterns": ["reblaze", "access denied by reblaze"],
      "status_codes": [403],
      "confidence": "high"
    },
    "SiteLock": {
      "headers": ["x-sitelock-protection", "x-sitelock"],
      "cookies": [],
      "body_patterns": ["sitelock", "blocked by sitelock"],
      "status_codes": [403],
      "confidence": "high"
    }
