{
  "version": "1.0.0",
  "description": "WAF detection signatures",
  "wafs": {
    "Cloudflare": {
      "headers": ["cf-ray", "cf-cache-status", "cf-request-id", "cf-connecting-ip"],
      "cookies": ["__cfduid", "__cf_bm", "cf_clearance"],
      "body_patterns": ["cloudflare", "ray id:", "cf-ray", "attention required! | cloudflare"],
      "status_codes": [403, 503],
      "confidence": "high"
    },
    "AWS WAF": {
      "headers": ["x-amzn-requestid", "x-amz-cf-id", "x-amzn-trace-id", "x-amz-apigw-id"],
      "cookies": ["awselb", "awsalb", "awsalbcors"],
      "body_patterns": ["aws", "access denied", "not authorized"],
      "status_codes": [403],
      "confidence": "medium"
    },
    "Akamai": {
      "headers": ["x-check-cacheable", "x-akamai-transformed", "akamai-origin-hop", "x-akamai-request-id"],
      "cookies": ["ak_bmsc", "bm_sz", "_abck"],
      "body_patterns": ["access denied", "akamai", "reference #"],
      "status_codes": [403],
      "confidence": "high"
    },
    "Imperva/Incapsula": {
      "headers": ["x-iinfo", "x-cdn"],
      "cookies": ["incap_ses_", "visid_incap_", "nlbi_"],
      "body_patterns": ["incapsula", "request unsuccessful", "incident id", "powered by incapsula"],
      "status_codes": [403],
      "confidence": "high"
    },
    "F5 BIG-IP ASM": {
      "headers": ["x-cnection", "x-wa-info", "x-forwarded-for"],
      "cookies": ["ts", "f5avr", "bigipserver"],
      "body_patterns": ["the requested url was rejected", "f5 networks", "your support id is"],
      "status_codes": [403],
      "confidence": "high"
    },
    "ModSecurity": {
      "headers": [],
      "cookies": [],
      "body_patterns": ["mod_security", "modsecurity", "406 not acceptable", "not acceptable!", "this error was generated by mod_security"],
      "status_codes": [403, 406],
      "confidence": "medium"
    },
    "Sucuri": {
      "headers": ["x-sucuri-id", "x-sucuri-cache"],
      "cookies": [],
      "body_patterns": ["sucuri website firewall", "access denied - sucuri", "cloudproxy"],
      "status_codes": [403],
      "confidence": "high"
    },
    "Barracuda": {
      "headers": [],
      "cookies": ["barra_counter_session"],
      "body_patterns": ["barracuda", "you have been blocked by network security", "barracuda networks"],
      "status_codes": [403],
      "confidence": "medium"
    },
    "Fortinet FortiWeb": {
      "headers": ["fortiwafsid"],
      "cookies": [],
      "body_patterns": ["fortigate", "fortiwall", "this request is blocked by the website owner", "fortiwebcloud"],
      "status_codes": [403],
      "confidence": "medium"
    },
    "Wordfence": {
      "headers": [],
      "cookies": [],
      "body_patterns": ["wordfence", "generated by wordfence", "your access to this site has been limited by the site owner"],
      "status_codes": [403],
      "confidence": "high"
    },
    "Nginx WAF/Naxsi": {
      "headers": [],
      "cookies": [],
      "body_patterns": ["naxsi", "naxsi_sig", "libinjection"],
      "status_codes": [400],
      "confidence": "medium"
    },
    "Citrix NetScaler": {
      "headers": ["ns_af", "citrix-transaction-id", "x-nsprotocol"],
      "cookies": ["ns_af", "citrix_ns_id", "NSC_"],
      "body_patterns": ["citrix", "netscaler", "ns_af"],
      "status_codes": [403],
      "confidence": "medium"
    },
    "Varnish Cache": {
      "headers": ["x-varnish", "via"],
      "cookies": [],
